# AgriMind AI backend configuration. Copy to backend/.env and fill in.
# This file is read only by the Python backend; keys are never sent to the browser.

# --- Grok by xAI (primary LLM) ---
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast-reasoning
LLM_PROVIDER=xai
# Seconds before a Grok request times out (retries with backoff on 429 / 5xx / timeouts)
LLM_TIMEOUT=90

# --- Optional local LLM via Ollama (set LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Retrieval: multilingual embeddings (English/Kannada/Hindi), downloaded once (~470 MB) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Live Agmarknet mandi prices (free key from https://data.gov.in) ---
DATA_GOV_API_KEY=
